# System 3: agentic-search-ui configuration
#
# Copy to .env and fill in real values: `cp env.example .env`
# .env is gitignored. Never commit real secrets. Dev and prod use separate credentials.
# This is a placeholder template only. Values below are examples or empty.
# The env surface is derived from the Phase 4.0 capability sheet
# (requirements/phase_4/API_capability_sheet.md) and the locked stack decisions.
# It is refined during the Phase 6 build.

# ---------------------------------------------------------------------------
# Layer 1: knowledge graph connection (Hetzner AGE graph, READ-ONLY)
# ---------------------------------------------------------------------------
# The graph is SSH-only and firewalled today (docs/data-engineering/
# Knowledge_graph_on_server_reference.md). How the deployed agent reaches it is
# an OPEN Phase 4.1 decision: co-locate with the box, a secured remote Postgres
# role (TLS + IP allowlist), an SSH tunnel, or a thin read-only HTTPS query
# service in front of the graph. The credential MUST be read-only by design
# (the graph connection never gets write access).
GRAPH_PG_HOST=
GRAPH_PG_PORT=5432
GRAPH_PG_USER=kg_reader
GRAPH_PG_PASSWORD=
GRAPH_PG_DBNAME=ncbi_kg
# If Layer 1 is fronted by a read-only HTTPS query service instead of psycopg2,
# set this and leave the GRAPH_PG_* block empty:
GRAPH_QUERY_URL=
# Bearer credential for the read-only HTTPS graph query service (Decision D, v1
# transport). Required alongside GRAPH_QUERY_URL once that service is live; the
# service authenticates every call against this token, never an IP allowlist alone.
GRAPH_QUERY_TOKEN=

# ---------------------------------------------------------------------------
# LLM harness (three tiers: guard, plan, synth over LiteLLM + OpenRouter)
# ---------------------------------------------------------------------------
# OpenRouter is the primary gateway. The model per tier is chosen in Phase 6 by
# model-bench, so add only the provider keys the chosen models actually need.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional explicit model id per tier (else resolved in app config):
GUARD_MODEL=
PLAN_MODEL=
SYNTH_MODEL=

# ---------------------------------------------------------------------------
# Layer 2: NCBI APIs
# ---------------------------------------------------------------------------
# NCBI_API_KEY raises E-utilities from 3 to 10 requests/second (free key).
# NCBI_EMAIL is sent as the E-utilities tool and email parameter (etiquette).
# No key is required for Datasets API v2, Variation Services, or PubChem.
NCBI_API_KEY=
NCBI_EMAIL=

# ---------------------------------------------------------------------------
# Layer 3: enrichment APIs
# ---------------------------------------------------------------------------
# No key is required for PubTator3, LitVar2, LitSense, or ClinicalTrials.gov v2.
# Documented here so no one hunts for credentials that do not exist.

# ---------------------------------------------------------------------------
# User data database (PostgreSQL, separate from the knowledge graph)
# Holds auth users plus the interactions and cq_candidates feedback-loop tables.
# ---------------------------------------------------------------------------
USER_DB_URL=postgresql://localhost:5432/search_agent_users

# ---------------------------------------------------------------------------
# Cache (Redis) for Layer 2 and Layer 3 API responses
# Reference TTLs: gene 1 week, variant 1 week, publication 1 day.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_SECRET=
# Comma-separated user UUIDs allowed to set RequestContext.operator_mode=true
# on POST /query and see real cost/token data instead of the redacted,
# end-user-facing response (Section 19.4). Empty or unset means nobody is
# allowed: operator_mode is silently ignored (fail-closed), never granted by
# default. No role/permission system exists yet (Section 15), so this
# allowlist is the interim access control until one does.
OPERATOR_USER_IDS=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# LangSmith: per-run tracing. PostHog: behavioral analytics.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-search-ui
LANGCHAIN_TRACING_V2=true
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com

# ---------------------------------------------------------------------------
# Cost control (safety-critical hard caps). Starter values, tune in app config.
# PER_USER_DAILY_QUERY_CAP is a query COUNT (100/day), not a dollar figure;
# the other three caps below are USD or seconds, as their suffix states.
# ---------------------------------------------------------------------------
PER_QUERY_COST_CAP_USD=
PER_USER_DAILY_QUERY_CAP=
SYSTEM_DAILY_CAP_USD=
PER_STEP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
