+                source_url="https://www.ncbi.nlm.nih.gov/clinvar/variation/2",
+                entity_type="Variant",
+                curie="",
+            ),
+        ),
+    ]
+    assert answer_trust_line("ask", HIGH_INSUFFICIENT, claims) == (
+        "Based on 2 sources cited, all from ClinVar"
+    )
