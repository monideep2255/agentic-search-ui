+"""Card 126 (owner, 2026-10-17): the trust line says when sources disagree.
+
+A floor can lift the aggregate outcome to `ask`, which outranks `flag`. The
+line used to say "Based on 2 sources cited ..." then, under two records that
+contradict each other. The outcome stays `ask`; only the words change.
+"""
+
+from __future__ import annotations
+
+from system_03_search_agent.synthesis.findings import SynthFinding
+from system_03_search_agent.synthesis.grounding import GroundedClaim
+from system_03_search_agent.synthesis.trust import ClaimTrust, answer_trust_line
+
+_DISAGREE = "Sources disagree on at least one claim"
+
+
+def _finding(index: int, url: str, value: str) -> SynthFinding:
+    return SynthFinding(
+        ref_index=index,
+        citation_id=f"c-{index}",
+        layer="layer_1_graph",
+        tool="cypher_query",
+        field="clinical_significance",
+        field_value=value,
+        source_url=url,
+        entity_type="Variant",
+        curie="",
+    )
+
+
+def _two_databases(second: str = "Benign") -> list[GroundedClaim]:
+    findings = [
+        _finding(1, "https://www.ncbi.nlm.nih.gov/clinvar/variation/17661", "Pathogenic"),
+        _finding(2, "https://www.ncbi.nlm.nih.gov/snp/rs80357713", second),
+    ]
+    return [GroundedClaim(claim_text=f.field_value, finding=f) for f in findings]
+
+
+def test_discordant_high_risk_claim_under_an_ask_floor_says_sources_disagree() -> None:
+    trusts = [ClaimTrust("c-1", "high", True, "discordant", "flag")]
+    assert answer_trust_line("ask", trusts, _two_databases()) == _DISAGREE
+
+
+def test_plain_flag_is_unchanged() -> None:
+    trusts = [ClaimTrust("c-1", "high", True, "discordant", "flag")]
+    assert answer_trust_line("flag", trusts, _two_databases()) == _DISAGREE
+
+
+def test_discordant_low_risk_claim_does_not_trigger_the_warning() -> None:
+    trusts = [ClaimTrust("c-1", "low", True, "discordant", "ask")]
+    assert answer_trust_line("ask", trusts, _two_databases()) == (
+        "Based on 2 sources cited from ClinVar and dbSNP"
+    )
+
+
+def test_discordant_claim_that_is_not_cited_does_not_trigger_the_warning() -> None:
+    trusts = [ClaimTrust("c-99", "high", True, "discordant", "ask")]
+    assert answer_trust_line("ask", trusts, _two_databases()).startswith("Based on 2 sources")
+
+
+def test_insufficient_high_risk_keeps_the_could_not_be_compared_clause() -> None:
+    trusts = [ClaimTrust("c-1", "high", True, "insufficient", "ask")]
+    assert answer_trust_line("ask", trusts, _two_databases()) == (
+        "Based on 2 sources cited from ClinVar and dbSNP; their values could not be compared"
+    )
+
+
+def test_floor_only_ask_keeps_based_on() -> None:
+    trusts = [ClaimTrust("c-1", "high", True, "concordant", "ask")]
+    assert answer_trust_line("ask", trusts, _two_databases()) == (
+        "Based on 2 sources cited from ClinVar and dbSNP"
+    )
+
+
+def test_concordant_answer_keeps_confirmed() -> None:
+    claims = _two_databases("Pathogenic")
+    trusts = [ClaimTrust("c-1", "high", True, "concordant", "answer")]
+    assert answer_trust_line("answer", trusts, claims) == "Confirmed by 2 independent databases"
+
+
+def test_refuse_gives_none_even_with_a_discordant_claim() -> None:
+    trusts = [ClaimTrust("c-1", "high", True, "discordant", "flag")]
+    assert answer_trust_line("refuse", trusts, _two_databases()) is None
