+def _grounded(*sentences: str) -> GroundingResult:
+    return GroundingResult(
+        narrative="x",
+        claims=[],
+        stripped_count=0,
+        refused=False,
+        sentences=sentences,
+        sentence_origins=tuple(range(len(sentences))),
+    )
+
