+        name="gene_variant_disease_link_many",
+        cypher=" UNION ALL ".join(branches),
+        edge_label=_VARIANT_DISEASE_EDGE,
+        fold=(_VARIANT_VAR, _FOLD_ALIAS, FOLD_FIELD_VARIANT_CONDITIONS),
+        branch_row_cap=share,
