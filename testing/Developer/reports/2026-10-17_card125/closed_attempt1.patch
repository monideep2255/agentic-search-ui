+def _findings_block(messages: list[dict[str, str]]) -> str:
+    user = messages[1]["content"]
+    start = user.index("FINDINGS:")
+    return user[start : user.index("USER QUESTION", start)]
+
+
+def _question_spans(text: str) -> int:
+    return len(_QUESTION_SPAN.findall(text))
+
+
+def _pick() -> Any:
+    return graph_module._pick_representative_field
+
+
+def _prompt_for_live_titles(
+    titles: list[str], abstracts: list[str] | None = None
+) -> list[dict[str, str]]:
+    """Titles through the real XML extraction, row shaping and prompt builder."""
+    body = "".join(
+        f"<PubmedArticle><MedlineCitation><PMID>{1000 + i}</PMID><Article>"
+        f"<ArticleTitle>{_xml_escape(title)}</ArticleTitle>"
+        f"{_abstract_xml(abstracts[i]) if abstracts else ''}</Article>"
+        f"</MedlineCitation></PubmedArticle>"
+        for i, title in enumerate(titles)
+    )
+    root = ElementTree.fromstring(f"<PubmedArticleSet>{body}</PubmedArticleSet>")
+    records = ncbi_eutils_actions._extract_pubmed_articles(root)
+    output = NcbiEfetchOutput(
+        status="ok",
+        action="fetch",
+        records=records,
+        record_count=len(records),
+        truncated=False,
+    )
+    structured = graph_module._ncbi_efetch_output_to_structured_fields(output, "pubmed_abstracts")
+    finding = Finding(
+        call_id="ne-1",
+        tool="ncbi_efetch",
+        layer="layer_2_api",
+        source="structured_pass_through",
+        structured_fields=structured,
+        extracted_entities=None,
+        normalized_ids=None,
+        evidence_summary=None,
+    )
+    synth, _ = build_synth_findings([finding], _pick())
+    return build_synth_messages("Which papers mention CFTR?", synth)
+
+
+def _abstract_xml(text: str) -> str:
+    return f"<Abstract><AbstractText>{_xml_escape(text)}</AbstractText></Abstract>"
+
+
+def _xml_escape(text: str) -> str:
+    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+
+
+def _graph_paper(pmid: str, ref_index: int) -> SynthFinding:
+    return SynthFinding(
+        ref_index=ref_index,
+        citation_id=f"cq-1-{ref_index}",
+        layer="layer_1_graph",
+        tool="cypher_query",
+        field="curie",
+        field_value=f"PMID:{pmid}",
+        source_url=f"https://pubmed.ncbi.nlm.nih.gov/{pmid}/",
+        curie_fallback=True,
+        entity_type="Article",
+        curie=f"PMID:{pmid}",
+        call_id="cq-1",
+    )
+
+
+def _prompt_for_graph_titles(
+    monkeypatch: pytest.MonkeyPatch, titles: list[str]
+) -> list[dict[str, str]]:
+    """Titles through the graph path: fake EFetch, real clean and rewrite."""
+    article_titles.reset_cache_for_tests()
+    by_pmid = {str(2000 + i): title for i, title in enumerate(titles)}
+
+    async def fake_fetch(params: Any) -> NcbiEfetchOutput:
+        records = [
+            NcbiEfetchRecord(
+                id=pmid,
+                db="pubmed",
+                fields={"title": by_pmid[pmid]},
+                source_url=f"https://pubmed.ncbi.nlm.nih.gov/{pmid}/",
+            )
+            for pmid in params.ids
+            if pmid in by_pmid
+        ]
+        return NcbiEfetchOutput(
+            status="ok",
+            action="fetch",
+            records=records,
+            record_count=len(records),
+            truncated=False,
+        )
+
+    monkeypatch.setattr(ncbi_eutils_actions, "fetch", fake_fetch)
+    findings = [_graph_paper(pmid, i + 1) for i, pmid in enumerate(by_pmid)]
+    resolved = asyncio.run(
+        article_titles.resolve_article_titles(article_titles.article_curies_to_name(findings))
+    )
+    rewritten = article_titles.apply_resolved_article_titles(findings, resolved)
+    return build_synth_messages("Which papers mention CFTR?", rewritten)
+
