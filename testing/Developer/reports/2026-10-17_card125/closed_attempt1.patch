+    if not plans:
+        return text
+    out: list[str] = []
+    n = len(text)
+    i = 0
+    while i < n:
+        plan = plans.get(i)
+        if plan is None:
+            out.append(text[i])
+            i += 1
+            continue
+        if plan[0] == "head":
+            i = plan[1]
+            continue
+        if plan[0] == "comment":
+            i = plan[1]
+            if out and not out[-1].isspace() and i < n and not text[i].isspace():
