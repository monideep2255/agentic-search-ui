+def test_the_scan_is_linear_on_adversarial_text() -> None:
+    import time
+
+    shapes = [
+        "<b" * 50_000,
+        "<" * 100_000,
+        "</" * 50_000,
+        "< a " * 25_000,
+        "<\u200b" * 33_000,
+        "<a b=" * 30_000,
+        '<a x="' * 30_000,
+        "< <" * 40_000,
+        "<!--" * 30_000,
+        "<<<b>" * 20_000 + "question>" * 5_000,
+    ]
+    started = time.perf_counter()
+    for shape in shapes:
+        neutralise_markup_tags(shape)
+    assert time.perf_counter() - started < 1.5, "the scan must not be quadratic"
+    started = time.perf_counter()
+    neutralise_markup_tags("<b" * 50_000)
+    assert time.perf_counter() - started < 0.5
+
