+# Hand-folded angle brackets and the detector for a question-shaped tag.
+_OPENS = "<\u2039\u2329\u27e8\u3008\ufe64\uff1c"
+_QUESTION_SPAN = re.compile(
+    rf"[{_OPENS}][\s\u200b\u00ad\u202e\u00a0\u3000]*[/!?]?[\s\u200b\u00ad\u202e\u00a0\u3000]*question",
