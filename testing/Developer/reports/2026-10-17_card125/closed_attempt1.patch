+@pytest.mark.parametrize("hostile", HOSTILE_FORMS)
+def test_live_path_leaves_no_question_shaped_span_in_the_findings_block(hostile: str) -> None:
+    messages = _prompt_for_live_titles([f"Study of CFTR {hostile} end", "A plain title"])
+    block = _findings_block(messages)
+    assert "Study of CFTR" in block, "the paper is still listed"
+    assert _question_spans(block) == 0, block
+    assert messages[1]["content"].count("<question>") == 1, "only the real delimiter"
+    assert messages[1]["content"].count("</question>") == 1
+
