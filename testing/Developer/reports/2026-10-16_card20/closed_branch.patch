+    assert question is not None and question.clarification is not None
+    state = _state(
+        NO_GENE_QUESTION,
+        query_class="exploratory",
+        isolate_question=question,
+        clarification_needed=question.clarification,
+    )
+    await graph_module.plan_node(state)
+    assert calls == []
