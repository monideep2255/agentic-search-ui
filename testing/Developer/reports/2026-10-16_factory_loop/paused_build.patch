+"""Does the Factory review loop take the right one action per run, and only that?
+
+`.claude/skills/factory-loop/factory_loop.py` is the hourly orchestrator the
+product owner approved item by item on 2026-10-16 (DECISIONS.md, "The Factory
+review loop is approved item by item"). Every test drives it through a
+stand-in runner, `FakeWorld`, which answers git, gh, security, droid and the
+review agent from memory and records each call. No test runs a real tool.
+
+One test, or a small group, per decision path:
+
+- none open: the next card in the brief's order that is still in To do gets a
+  worktree and Factory, with a prompt that names the body file
+- a worktree with commits and no pull request: push, then open the pull
+  request from Factory's body file
+- CI pending: wait, no review
+- review merged: the allowed-tools list, the budget, the clean-up
+- changes requested: Factory's fix round with the review text as data, push
+- a second failure: held, with the owner's mention and the two options
+- the day's limits, two open pull requests, a fork's pull request
+- a push to any branch not named factory/... is refused
+- Factory's key never reaches a command line, a log, a prompt file or the
+  review run's environment
+- a missing or unknown verdict is a hold
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = REPO_ROOT / ".claude" / "skills" / "factory-loop" / "factory_loop.py"
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location("factory_loop", SCRIPT)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["factory_loop"] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+fl = _load()
+
+KEY = "fk-test-NOT-A-REAL-KEY-7f3a"
+OWNER = "monideep2255"
+
+BRIEF = """# Factory onboarding
+
+## How you work here
+
+One card at a time, in this order: 100, 106, 117, then 113. Cards 43 and 44 are merged.
+
+## Card 100: a very long email
+
+Dial 1. Branch `factory/card100-long-email-top-bar`.
+
+## Card 106: the tag
+
+Dial 1. Branch `factory/card106-risk-tag-one-line`.
+
+## Card 117: two marks
+
+Dial 1. Branch `factory/card117-answer-switch-marks`.
+
+## Not yours now
+"""
