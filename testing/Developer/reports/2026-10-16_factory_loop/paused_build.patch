+def pr(number: int, branch: str = "factory/card100-long-email-top-bar", head: str = "abc1234",
+       created: str = "2026-10-16T10:00:00Z", login: str = OWNER, fork: bool = False) -> dict:
+    return {"number": number, "headRefName": branch, "headRefOid": head, "createdAt": created,
+            "isCrossRepository": fork, "author": {"login": login}}
+
