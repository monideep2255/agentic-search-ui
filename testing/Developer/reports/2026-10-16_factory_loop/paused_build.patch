+def test_launch_agent_template_runs_hourly_and_logs_outside_the_repository():
+    import plistlib
+
+    text = (SCRIPT.parent / "com.factory-loop.plist.template").read_text()
+    assert "<repo-root>" in text and "<user>" in text
+    filled = text.replace("<repo-root>", "/r").replace("<user>", "u")
+    plist = plistlib.loads(filled.encode())
+    assert plist["StartInterval"] == 3600
+    assert plist["RunAtLoad"] is False
+    assert plist["ProgramArguments"][-1] == "/r/.claude/skills/factory-loop/factory_loop.py"
+    for key in ("StandardOutPath", "StandardErrorPath"):
+        assert plist[key].startswith("/") and "/u/.factory-loop/logs/" in plist[key]
