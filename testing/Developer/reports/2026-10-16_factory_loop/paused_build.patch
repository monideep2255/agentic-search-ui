+def review_json(text: str, cost: float = 0.42) -> str:
+    return json.dumps({"type": "result", "subtype": "success", "total_cost_usd": cost,
+                       "result": text})
+
+
+class FakeWorld:
+    """Answers every command from memory and records it."""
+
+    def __init__(self, tmp: Path) -> None:
+        self.calls: list[dict] = []
+        self.prs: list[dict] = []
+        self.checks: list[dict] = [{"name": "ci", "bucket": "pass"}]
+        self.diff_files = ["frontend/src/components/shell/AccountMenu.tsx",
+                           "frontend/e2e/long-email-top-bar.spec.ts"]
+        self.review_out = review_json("All good.\nFACTORY_LOOP_VERDICT: merged")
+        self.pr_state = "MERGED"
+        self.reviews = [{"body": "F-1: the email span has no test of its ellipsis."}]
+        self.ahead = 0
+        self.heads = ["aaa111", "bbb222"]
+        self.key = KEY
+        self.existing_for_branch: list[dict] = []
+        self.tmp = tmp
+
+    def __call__(self, argv, *, cwd=None, env=None, timeout=None):
+        self.calls.append({"argv": list(argv), "env": dict(env or {}), "cwd": cwd})
+        a = list(argv)
+        if a[0] == "git":
+            rest = a[3:] if a[1] == "-C" else a[1:]
+            if rest[0] == "show":
+                path = rest[1].split(":", 1)[1]
+                return fl.Result(0, BRIEF if path == fl.BRIEF else BOARD)
+            if rest[:2] == ["rev-list", "--count"]:
+                return fl.Result(0, f"{self.ahead}\n")
+            if rest[:2] == ["rev-parse", "HEAD"]:
+                head = self.heads.pop(0) if len(self.heads) > 1 else self.heads[0]
+                return fl.Result(0, head + "\n")
+            if rest[0] == "log":
+                return fl.Result(0, "fix(web-ui): Let a long email give way in the top bar\n")
+            if rest[:2] == ["worktree", "add"]:
+                Path(rest[4]).mkdir(parents=True)
+            return fl.Result(0)
+        if a[0] == "gh":
+            if a[1:3] == ["pr", "list"]:
+                if "--head" in a:
+                    return fl.Result(0, json.dumps(self.existing_for_branch))
+                return fl.Result(0, json.dumps(self.prs))
+            if a[1:3] == ["pr", "checks"]:
+                return fl.Result(0, json.dumps(self.checks))
+            if a[1:3] == ["pr", "diff"]:
+                return fl.Result(0, "\n".join(self.diff_files) + "\n")
+            if a[1:3] == ["pr", "view"] and "reviews" in a:
+                return fl.Result(0, json.dumps({"reviews": self.reviews}))
+            if a[1:3] == ["pr", "view"]:
+                return fl.Result(0, json.dumps({"state": self.pr_state}))
+            return fl.Result(0)
+        if a[0] == "security":
+            return fl.Result(0, self.key + "\n") if self.key else fl.Result(44, "", "not found")
+        if a[0] == "claude":
+            return fl.Result(0, self.review_out)
+        if a[0] == "droid":
+            return fl.Result(0, "done")
+        raise AssertionError(f"unexpected command {a}")
+
+    def find(self, *prefix: str) -> list[dict]:
+        return [c for c in self.calls if c["argv"][: len(prefix)] == list(prefix)]
+
+    def find_gh(self, *words: str) -> list[dict]:
+        return [c for c in self.calls if c["argv"][0] == "gh" and c["argv"][1: 1 + len(words)]
+                == list(words)]
+
+    def git_calls(self, *words: str) -> list[dict]:
+        out = []
+        for c in self.calls:
+            a = c["argv"]
+            if a[0] != "git":
+                continue
+            rest = a[3:] if a[1] == "-C" else a[1:]
+            if rest[: len(words)] == list(words):
+                out.append(c)
+        return out
+
