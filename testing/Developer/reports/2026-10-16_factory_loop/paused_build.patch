+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  The Factory review loop's launch agent: runs factory_loop.py once an hour
+  while the Mac is awake. A template: replace <repo-root> with the main
+  checkout's absolute path and <user> with the macOS account name, copy it to
+  ~/Library/LaunchAgents/com.factory-loop.plist, and load it with launchctl.
+  Install and switch-off steps: docs/build/Factory_review_loop.md.
+  PATH must name the folders that hold git, gh, the lead's command-line agent
+  and Factory's headless command: check each with `which` before loading.
+-->
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+  <key>Label</key>
+  <string>com.factory-loop</string>
+  <key>ProgramArguments</key>
+  <array>
+    <string><repo-root>/venv/bin/python</string>
+    <string><repo-root>/.claude/skills/factory-loop/factory_loop.py</string>
+  </array>
+  <key>WorkingDirectory</key>
+  <string><repo-root></string>
+  <key>StartInterval</key>
+  <integer>3600</integer>
+  <key>RunAtLoad</key>
+  <false/>
+  <key>EnvironmentVariables</key>
+  <dict>
+    <key>PATH</key>
+    <string>/Users/<user>/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
+    <key>HOME</key>
+    <string>/Users/<user></string>
+  </dict>
+  <key>StandardOutPath</key>
+  <string>/Users/<user>/.factory-loop/logs/launchd.out.log</string>
+  <key>StandardErrorPath</key>
+  <string>/Users/<user>/.factory-loop/logs/launchd.err.log</string>
+</dict>
+</plist>
