+    loop = make_loop(tmp_path, world)
+    assert loop.run_once() == "held"
+    assert not world.find("droid")
+    comment = world.find_gh("pr", "comment")
+    assert len(comment) == 1 and comment[0]["argv"][3] == "57"
+    body = Path(comment[0]["argv"][-1]).read_text()
+    assert f"@{OWNER}" in body
+    assert "Merge with the open item named" in body
+    assert "Close this pull request and re-split" in body
+    assert "F-2 still open" in body
