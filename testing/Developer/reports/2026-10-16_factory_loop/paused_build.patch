+def make_loop(tmp_path, world, *, dry_run=False):
+    cfg = fl.Config(repo_root=tmp_path / "repo", state_dir=tmp_path / "state",
+                    worktree_root=tmp_path / "wt", today=dt.date(2026, 10, 16), dry_run=dry_run)
+    (tmp_path / "repo").mkdir(exist_ok=True)
+    return fl.FactoryLoop(cfg, world)
