+def test_the_key_never_reaches_a_command_line_log_prompt_or_the_review(tmp_path, world,
+                                                                      monkeypatch):
+    # The owner's shell may export a key of its own; it must not reach the review either.
+    monkeypatch.setenv(fl.KEY_NAME, "shell-exported-NOT-A-REAL-KEY")
+    (tmp_path / "wt" / "factory-100").mkdir(parents=True)
+    make_loop(tmp_path, world).run_once()  # start Factory on card 106
+    world.prs = [pr(57)]
+    world.review_out = review_json("FACTORY_LOOP_VERDICT: changes_requested")
+    make_loop(tmp_path, world).run_once()  # review, then Factory's fix round
+    assert world.find("droid") and world.find("claude")
+    for call in world.calls:
+        assert KEY not in " ".join(call["argv"])
+        if call["argv"][0] == "droid":
+            assert call["env"][fl.KEY_NAME] == KEY
+        else:
+            assert fl.KEY_NAME not in call["env"]
+    for path in (tmp_path / "state").rglob("*"):
+        if path.is_file():
+            assert KEY not in path.read_text(), path
