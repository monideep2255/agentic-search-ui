@@ -0,0 +1,855 @@
+"""Card 56, slice 1 (2026-10-17): a name Think cannot place is looked up
+whole, never cut into pieces.
+
+What a person gets, in the product owner's words (`DECISIONS.md`,
+2026-10-17, and `testing/Developer/reports/2026-10-17_card56/design.md`):
+
+- A question naming "SARS CoV-2" with a space, "SARS CoV 2" or "COVID-19
+  virus" is read as the virus, NCBI Taxonomy 2697049, and the plan line says
+  so in words, whether the question-reading model tagged the phrase as a
+  disease, as nothing (then asked once more), or as an organism.
+- "SARS" is never taken out of "SARS CoV-2", "SARS CoV 2" or "SARS-CoV-2",
+  nor "COVID" out of "COVID-19".
+- A phrase that confirms as the type the model gave it is never looked up
+  again, so every question that answers today answers the same way.
+- Several fits are asked about with the choices as buttons; nothing found,
+  on a question that asks for an organism's records, says what to type.
+- At most two phrases and ten NCBI calls a question, apart from the
+  question's own ceiling; never on the isolate path.
+
+Drives the real `think_node` with the Plan-tier model, NCBI's `search` and
+`summary` actions and the gene resolver faked, from values measured live on
+2026-10-17 (`code_map.md`, E1, and `build_slice1.md`). No network.
+
+The mutation each arm guards, recorded with its result in `build_slice1.md`:
+the fallback cutting a hyphen piece; a confirmed span reaching the lookup;
+MedGen's loose title search in the lookup; no content retry; no cap.
+"""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+from system_03_search_agent.contracts.query import Query
+from system_03_search_agent.core import graph as graph_module
+from system_03_search_agent.core import phrase_lookup
+from system_03_search_agent.harness import call_budget
+from system_03_search_agent.harness import harness as harness_module
+from system_03_search_agent.harness.harness import HarnessCallError
+from system_03_search_agent.tools import ncbi_eutils_actions
+
+SARS2 = "NCBITaxon:2697049"
+SARS2_NAME = "Severe acute respiratory syndrome coronavirus 2"
+SRA_QUESTION = "Find SRA runs of {} sequenced on Illumina from clinical respiratory samples"
+THE_FOUR = ["SARS CoV-2", "SARS-CoV-2", "sars cov 2", "COVID-19 virus"]
+
+#: NCBI Taxonomy `<name>[All Names]`, after `_organism_taxids`'s cleaning,
+#: as answered live on 2026-10-17.
+TAXONOMY: dict[str, list[str]] = {
+    "sars cov-2": ["2697049"],
+    "sars-cov-2": ["2697049"],
+    "sars cov 2": ["2697049"],
+    "sars cov2": ["2697049"],
+    "covid-19 virus": ["2697049"],
+    "covid-19": ["2697049"],
+    "sars": ["694009"],
+    "mycobacterium tuberculosis": ["1773"],
+    "salmonella": ["590"],
+    "human": ["9606"],
+}
+TAXON_NAMES = {
+    "2697049": SARS2_NAME,
+    "694009": "Severe acute respiratory syndrome-related coronavirus",
+    "1773": "Mycobacterium tuberculosis",
+}
+#: MedGen as answered live: "SARS[title]" three records, "MODY[title]" one
+#: here, "GERD[title]" one; "SARS[title] AND CoV[title]",
+#: "COVID[title] AND 19[title]" and "SRA[title]" none.
+MEDGEN = {
+    "SARS[title]": ["1001", "1002", "1003"],
+    "MODY[title]": ["2001"],
+    "gerd[title]": ["3001"],
+    "Mycobacterium[title] AND tuberculosis[title]": ["4001", "4002"],
+}
+MEDGEN_TITLES = {
+    "1001": ("C1519126", "SARS Coronavirus Protease Pathway"),
+    "1002": ("C4302012", "Probable SARS"),
+    "1003": ("C4302019", "SARS (severe acute respiratory syndrome) confirmed"),
+    "2001": ("C1833382", "Impaired glucose tolerance in MODY"),
+    "3001": ("C0017168", "Gastroesophageal reflux disease"),
+    "4001": ("C0041296", "Tuberculosis"),
+    "4002": ("C0275921", "Mycobacterium tuberculosis infection"),
+}
+GENES = {"BRCA1": "NCBIGene:672", "GCK": "NCBIGene:2645", "TP53": "NCBIGene:7157"}
+
+
+class _Record:
+    def __init__(self, fields: dict[str, Any]) -> None:
+        self.fields = fields
+
+
+class _Ncbi:
+    """Fake ESearch, ESummary and gene resolver; every call is recorded and,
+    like the real transport, charged to whatever call budget is bound."""
+
+    def __init__(self, monkeypatch: pytest.MonkeyPatch, genes: dict[str, str] | None = None):
+        self.searched: list[tuple[str, str]] = []
+        self.summaries: list[tuple[str, tuple[str, ...]]] = []
+        self.genes_asked: list[str] = []
+        genes = GENES if genes is None else genes
+
+        def _charge() -> bool:
+            try:
+                call_budget.charge_one_call(tool="ncbi_transport:fake", layer=2)
+            except call_budget.CallBudgetExceededError:
+                return False
+            return True
+
+        async def _search(params: Any) -> Any:
+            if not _charge():
+                raise call_budget.CallBudgetExceededError(tool="fake", calls_made=0, limit=0)
+            self.searched.append((params.db, params.term))
+            if params.db == "taxonomy":
+                ids = TAXONOMY.get(params.term.split("[")[0].strip().casefold(), [])
+            elif params.db == "medgen":
+                ids = MEDGEN.get(params.term, [])
+            else:
+                ids = []
+            return SimpleNamespace(
+                status="ok" if ids else "empty",
+                records=[_Record({"idlist": ids})] if ids else [],
+            )
+
+        async def _summary(params: Any) -> Any:
+            if not _charge():
+                raise call_budget.CallBudgetExceededError(tool="fake", calls_made=0, limit=0)
+            self.summaries.append((params.db, tuple(params.ids)))
+            if params.db == "taxonomy":
+                records = [
+                    _Record({"taxid": uid, "scientificname": TAXON_NAMES[uid]})
+                    for uid in params.ids
+                    if uid in TAXON_NAMES
+                ]
+            else:
+                records = [
+                    _Record({"conceptid": MEDGEN_TITLES[uid][0], "title": MEDGEN_TITLES[uid][1]})
+                    for uid in params.ids
+                    if uid in MEDGEN_TITLES
+                ]
+            return SimpleNamespace(status="ok", records=records)
+
+        async def _gene(symbol: str, *, taxon: str = "human") -> str | None:
+            self.genes_asked.append(symbol)
+            return genes.get(symbol.strip().upper())
+
+        monkeypatch.setattr(ncbi_eutils_actions, "search", _search)
+        monkeypatch.setattr(ncbi_eutils_actions, "summary", _summary)
+        monkeypatch.setattr(graph_module, "resolve_symbol_to_curie", _gene)
+        graph_module._DISEASE_CURIE_CACHE.clear()
+        graph_module._ORGANISM_KNOWN_CACHE.clear()
+
+    def taxonomy_terms(self) -> list[str]:
+        return [term for db, term in self.searched if db == "taxonomy"]
+
+    def medgen_terms(self) -> list[str]:
+        return [term for db, term in self.searched if db == "medgen"]
+
+
+def _reply(entities: list[tuple[str, str]], record_type: str = "sra") -> str:
+    return graph_module._ThinkClassification(
+        query_class="exploratory",
+        entities=[graph_module._ThinkExtractedEntity(text=t, entity_type=k) for t, k in entities],
+        narrative="Asks for records.",
+        record_type=record_type,
+    ).model_dump_json()
+
+
+class _Model:
+    """Think's model: the replies in order, the last one repeated; every
+    message list it was sent is kept."""
+
+    def __init__(self, monkeypatch: pytest.MonkeyPatch, *replies: str, fail_after: int = 0):
+        self.sent: list[list[dict[str, Any]]] = []
+        self.replies = list(replies)
+
+        async def _dispatch(*args: Any, **kwargs: Any) -> Any:
+            messages = list(args[4])
+            if messages[0].get("content") != graph_module._THINK_SYSTEM_INSTRUCTION:
+                return SimpleNamespace(content="{}")
+            self.sent.append(messages)
+            if fail_after and len(self.sent) > fail_after:
+                raise HarnessCallError("plan tier unavailable", error_class="transient")
+            index = min(len(self.sent), len(self.replies)) - 1
+            return SimpleNamespace(content=self.replies[index])
+
+        monkeypatch.setattr(graph_module, "_dispatch_tier_call", _dispatch)
+        monkeypatch.setenv("GUARD_MODEL", "test-provider/guard-model")
+        monkeypatch.setenv("PLAN_MODEL", "test-provider/plan-model")
+        monkeypatch.setenv("SYNTH_MODEL", "test-provider/synth-model")
+
+
+def _state(text: str) -> dict[str, Any]:
+    return {
+        "query": Query(text=text, session_id="s-phrase", trace_id="t-phrase", user_id=None),
+        "harness": harness_module.Harness(trace_id="t-phrase"),
+        "seq": 0,
+        "findings": [],
+        "findings_count": 0,
+    }
+
+
+async def _think(text: str) -> dict[str, Any]:
+    return await graph_module.think_node(_state(text))
+
+
+def _think_payload(result: dict[str, Any]) -> Any:
+    event = next(e for e in result["events"] if e.type == "think")
+    return event.payload
+
+
+def _narrative(result: dict[str, Any]) -> str:
+    return _field(result, "narrative")
+
+
+def _field(result: dict[str, Any], name: str) -> Any:
+    payload = _think_payload(result)
+    return payload[name] if isinstance(payload, dict) else getattr(payload, name)
+
+
+def _outcome(result: dict[str, Any]) -> dict[str, Any]:
+    organism_records = result.get("organism_records")
+    return {
+        "resolved": [(e.text, e.curie) for e in result.get("resolved_entities") or []],
+        "clarification": result.get("clarification_needed"),
+        "organism_records": (
+            (organism_records.organism.curie, organism_records.record_type)
+            if organism_records is not None
+            else None
+        ),
+        "unresolved": result.get("unresolved_entity_symbols"),
+    }
+
+
+def _reading(phrase: str) -> str:
+    return f"Read '{phrase}' as the organism {SARS2_NAME} (NCBI Taxonomy 2697049)"
+
