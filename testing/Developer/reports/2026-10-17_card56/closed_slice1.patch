+"""Whole-phrase lookup for a name Think could not place (card 56, slice 1).
+
+A name the question-reading model tagged as a disease that MedGen did not
+bind, or as an organism that NCBI Taxonomy did not know, used to be dropped
+without trace, and the word fallback then cut a piece out of it ("SARS" out
+of "SARS CoV-2") and answered about a different subject. The product
+owner's call of 2026-10-17 (`DECISIONS.md`): look the whole phrase up in
+NCBI, use it when exactly one record fits and say which, otherwise ask the
+person with the choices found, and never cut a word into pieces.
+
+What "fits" means, per database, reusing the cached primitives in
+`core.graph` (code map B2, `testing/Developer/reports/2026-10-17_card56/`):
+
+- Taxonomy: the phrase as a name, `<phrase>[All Names]`
+  (`graph._organism_taxids`, which reads two ids so one search tells one
+  record from several).
+- Gene: the phrase as an official symbol in the question's organism, human
+  when none is named (`graph.resolve_symbol_to_curie`, which confirms the
+  record's own symbol, so an alias never fits).
+- MedGen: a record whose title IS the phrase (`graph.medgen_exact_title_records`,
+  the exact-title rule of `resolve_disease_mention_to_curies`), never the
+  loose title search, which is "several" for almost any phrase.
+
+Exactly one record across the three is used; two or more are offered as
+choices; none is said. Every NCBI call made here runs under a budget of its
+own (`LookupBudget`), at most `MAX_PHRASES` phrases and `MAX_CALLS` calls
+per question, kept apart from the per-question ceiling of
+`call_budget.MAX_LAYER_2_3_CALLS_PER_QUERY` so a gene question's own
+searches are never squeezed out.
+
+Also here, pure text with no network: `name_runs`, the whole-word reading
+of a question the guarded word fallback (`graph._gene_shaped_fallback_candidates`)
+draws its candidates from, so a candidate is never a piece of a
+hyphen-joined word.
+
+Depends on:
+    - system_03_search_agent.core.graph (`_organism_taxids`,
+      `resolve_symbol_to_curie`, `medgen_exact_title_records`,
+      `_MAX_ORGANISM_LOOKUP_CHARS`), imported at call time because `graph`
+      imports this module, and so a test's stand-in for a primitive applies
+    - system_03_search_agent.harness.call_budget (the lookup's own budget)
+    - system_03_search_agent.tools.ncbi_eutils_actions (`summary`, the
+      Taxonomy names a reading line and a choice are written with)
+
+Reads:
+    - Nothing from the environment.
+
+Writes:
+    - Nothing. NCBI calls go through the repository's transport and its
+      audit hook, as every other lookup does.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+import unicodedata
+from collections.abc import Iterator, Sequence
+from contextlib import contextmanager
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Final, Literal
+
+from system_03_search_agent.harness import call_budget
+
+if TYPE_CHECKING:  # pragma: no cover - typing only
+    from system_03_search_agent.harness.harness import QueryClass
+
+logger = logging.getLogger(__name__)
+
+#: The owner's cap, proposed by the lead (design.md, Part 1): at most two
+#: phrases looked up per question.
+MAX_PHRASES: Final[int] = 2
+#: At most ten NCBI calls for those lookups, counted apart from the
+#: per-question ceiling of twenty. A lookup takes up to six: one Taxonomy
+#: search, up to three for the gene (Datasets, ESearch, ESummary), two for
+#: MedGen (search and summary, shared with the disease check that ran before
+#: it), and one Taxonomy summary for the name it is read as.
+MAX_CALLS: Final[int] = 10
+#: The longest phrase quoted back to the person in a question or a line.
+_MAX_QUOTED_CHARS: Final[int] = 60
+#: The longest choice offered as a button (`ThinkPayload.clarifying_options`
+#: allows 220 characters per item and four items).
+_MAX_OPTION_CHARS: Final[int] = 220
+_MAX_OPTIONS: Final[int] = 4
+#: The tool name the budget's reserved slots are charged under. Never a
+#: network call: see `LookupBudget.calls`.
+_RESERVED_TOOL: Final[str] = "phrase_lookup:reserved"
+#: A gene symbol as the Datasets and ESearch inputs accept it: one word of
+#: letters, digits, dots and hyphens, at most 30 characters
+#: (`NcbiEfetchInput.symbol`'s own bound).
+_SYMBOL_SHAPE = re.compile(r"[A-Za-z0-9][A-Za-z0-9.\-]{0,29}")
+
+FitKind = Literal["organism", "gene", "condition"]
+Outcome = Literal["one", "several", "none", "unknown"]
+
+
+# ---------------------------------------------------------------------------
+# Whole words, never pieces (pure text)
+# ---------------------------------------------------------------------------
+
+
+def is_name_joiner(char: str) -> bool:
+    """A hyphen or dash that joins two parts of one name: the ASCII hyphen,
+    any Unicode dash punctuation (category Pd: U+2010 hyphen, U+2011
+    non-breaking hyphen, the figure, en and em dashes, U+FF0D) and the minus
+    sign U+2212, which pasted text sometimes carries in their place."""
+    return unicodedata.category(char) == "Pd" or char == "−"
+
+
+@dataclass(frozen=True)
+class NameWord:
+    """One whole word of a question: letters and digits, with any pieces
+    joined by a single hyphen or dash kept together ("SARS-CoV-2" is one
+    word, never "SARS", "CoV" and "2")."""
+
+    start: int
+    end: int
+    pieces: tuple[str, ...]
+
+
+_ALNUM_RUN = re.compile(r"[A-Za-z0-9]+")
+#: Characters that may sit between two words of one name: spaces, a hyphen
+#: or dash, a slash, a full stop with no space ("SARS.CoV.2") and the soft
+#: hyphen U+00AD that text pasted from a web page or PDF carries invisibly.
+_NAME_GAP_CHARS: Final[str] = "/.­"
+_MAX_NAME_GAP_CHARS: Final[int] = 3
+
+
+def name_words(text: str) -> list[NameWord]:
+    """Every whole word in `text`, in order."""
+    runs = [(m.start(), m.end()) for m in _ALNUM_RUN.finditer(text)]
+    words: list[NameWord] = []
+    index = 0
+    while index < len(runs):
+        start, end = runs[index]
+        pieces = [text[start:end]]
+        while (
+            index + 1 < len(runs)
+            and runs[index + 1][0] == end + 1
+            and is_name_joiner(text[end])
+        ):
+            index += 1
+            end = runs[index][1]
+            pieces.append(text[runs[index][0] : end])
+        words.append(NameWord(start=start, end=end, pieces=tuple(pieces)))
+        index += 1
+    return words
+
+
+def admits_token_shape(token: str) -> bool:
+    """The word fallback's shape rule, unchanged since UI fix set 8: 2 to 8
+    letters and digits, not a bare number, and either carrying a digit
+    (`brca1`, `tp53`) or all capitals (`GCK`, `MODY`). Nothing else tells a
+    symbol from an English word without a word list."""
+    if not (2 <= len(token) <= 8) or not token.isalnum() or not token.isascii():
+        return False
+    if token.isdigit():
+        return False
+    return any(ch.isdigit() for ch in token) or (token.isalpha() and token.isupper())
+
+
+def _continues_a_name(previous: NameWord, word: NameWord) -> bool:
+    """Whether `word` reads as a further part of the name `previous` is part
+    of: a mixed-case part such as "CoV" or "CoV-2", a number after a word
+    with no digit ("CoV 2", "COVID 19"), a hyphen-joined part ending in a
+    number ("COV-2"), or a word the shape rule admits on its own ("SARS
+    COV"). Text cannot tell "SARS CoV-2" from "BRCA1 ClinVar", so a run of
+    two or more words is checked against NCBI Taxonomy before it is used
+    (`split_unplaced_runs`); this rule only proposes it."""
+    first = word.pieces[0]
+    if len(word.pieces) == 1 and first.isdigit():
+        return not any(ch.isdigit() for ch in previous.pieces[-1])
+    if _is_mixed_case(word):
+        return True
+    if len(word.pieces) > 1 and word.pieces[-1].isdigit() and not any(
+        ch.isdigit() for ch in first
+    ):
+        return any(ch.isalpha() for ch in first)
+    return any(admits_token_shape(piece) for piece in word.pieces)
+
+
+def _gap_joins(text: str, previous: NameWord, word: NameWord) -> bool:
+    gap = text[previous.end : word.start]
+    if not gap or len(gap) > _MAX_NAME_GAP_CHARS:
+        return False
+    if "." in gap and any(ch.isspace() for ch in gap):
+        return False
+    return all(ch.isspace() or is_name_joiner(ch) or ch in _NAME_GAP_CHARS for ch in gap)
+
+
+def name_runs(text: str) -> list[tuple[int, int, int]]:
+    """The question's names as `(start, end, word_count)`: each whole word,
+    with the words after it that `_continues_a_name` reads as parts of the
+    same name joined to it. A word is never split, and a word that begins a
+    run is the run's first word, so no piece of a name is ever returned on
+    its own."""
+    words = name_words(text)
+    runs: list[tuple[int, int, int]] = []
+    index = 0
+    while index < len(words):
+        first = words[index]
+        last_index = index
+        if any(admits_token_shape(piece) for piece in first.pieces) or _is_mixed_case(first):
+            while (
+                last_index + 1 < len(words)
+                and _gap_joins(text, words[last_index], words[last_index + 1])
+                and _continues_a_name(words[last_index], words[last_index + 1])
+            ):
+                last_index += 1
+        runs.append((first.start, words[last_index].end, last_index - index + 1))
+        index = last_index + 1
+    return runs
+
+
+def _is_mixed_case(word: NameWord) -> bool:
+    """A capital, then a small letter followed by a capital, as in "CoV"."""
+    first = word.pieces[0]
+    return bool(first[:1].isupper() and re.search(r"[a-z][A-Z]", first))
+
+
+def is_candidate_name(text: str) -> bool:
+    """Whether a whole word or run may be a fallback candidate: one of its
+    pieces passes the shape rule. "SARS-CoV-2" may ("SARS"), "follow-up"
+    may not."""
+    return any(admits_token_shape(piece) for word in name_words(text) for piece in word.pieces)
+
+
+def digit_pieces(text: str) -> list[str]:
+    """The owner's one exception to "never cut a word" (2026-10-17): the
+    pieces of a hyphen-joined word that carry a digit and pass the shape
+    rule ("BRCA1" in "BRCA1-mutant", "TP53" in "TP53-null"). The caller
+    may try such a piece ONLY as an exact official human gene symbol, never
+    as a disease, an organism or through the phrase lookup. A piece with no
+    digit ("SARS" in "SARS-CoV-2", "COVID" in "COVID-19") is never one, and
+    neither is a bare number ("2", "19")."""
+    pieces: list[str] = []
+    for word in name_words(text):
+        if len(word.pieces) < 2:
+            continue
+        for piece in word.pieces:
+            if any(ch.isdigit() for ch in piece) and admits_token_shape(piece):
+                pieces.append(piece)
+    return pieces
+
+
+def is_single_token(text: str) -> bool:
+    """A candidate the gene fallback may try as a symbol, exactly as before
+    this card: one word, no hyphen, passing the shape rule."""
+    return admits_token_shape(text)
+
+
+# ---------------------------------------------------------------------------
+# The budget
+# ---------------------------------------------------------------------------
+
+
+class LookupBudget:
+    """At most `max_phrases` phrases and `max_calls` NCBI calls for one
+    question's lookups, counted apart from the per-question ceiling.
+
+    `calls()` binds a fresh call-budget scope for the duration of one batch
+    of lookups, so a call made inside it charges that scope and never the
+    question's own. The scope's ceiling is the module constant
+    `call_budget.MAX_LAYER_2_3_CALLS_PER_QUERY`; the slots this budget may
+    not spend are charged up front under `_RESERVED_TOOL`, which reaches no
+    network, so the transport refuses the call after the last one this
+    budget allows, before it goes out. A refused call reads to every
+    primitive as a failed lookup, which is never cached and never binds.
+    """
+
+    def __init__(
+        self,
+        query_class: QueryClass,
+        *,
+        max_phrases: int = MAX_PHRASES,
+        max_calls: int = MAX_CALLS,
+    ) -> None:
+        self.query_class = query_class
+        self.max_phrases = max_phrases
+        self.max_calls = max_calls
+        self.phrases_used = 0
+        self.calls_used = 0
+
+    def take_phrase(self) -> bool:
+        if self.phrases_used >= self.max_phrases:
+            return False
+        self.phrases_used += 1
+        return True
+
+    @contextmanager
+    def calls(self) -> Iterator[None]:
+        remaining = max(self.max_calls - self.calls_used, 0)
+        reserved = max(call_budget.MAX_LAYER_2_3_CALLS_PER_QUERY - remaining, 0)
+        token = call_budget.set_query_budget(self.query_class)
+        try:
+            for _ in range(reserved):
+                call_budget.charge_one_call(tool=_RESERVED_TOOL, layer=2)
+            yield
+        finally:
+            made = call_budget.calls_made() or 0
+            self.calls_used += max(made - reserved, 0)
+            call_budget.reset_query_budget(token)
+
+
+# ---------------------------------------------------------------------------
+# The lookup
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class PhraseFit:
+    """One NCBI record a whole phrase fits under."""
+
+    kind: FitKind
+    record_id: str
+    #: The record's own name: a Taxonomy scientific name, a gene's official
+    #: symbol, a MedGen title. Empty when NCBI did not say.
+    name: str
+    #: For a gene, the organism it was looked up in.
+    organism: str = ""
+
+    @property
+    def curie(self) -> str:
+        prefix = {"organism": "NCBITaxon", "gene": "NCBIGene", "condition": "MedGen"}[self.kind]
+        return f"{prefix}:{self.record_id}"
+
+    def describe(self) -> str:
+        """The record in words a person reads, with its NCBI identifier."""
+        if self.kind == "organism":
+            name = f" {self.name}" if self.name else ""
+            return f"the organism{name} (NCBI Taxonomy {self.record_id})"
+        if self.kind == "gene":
+            organism = f"{self.organism} " if self.organism else ""
+            return f"the {organism}gene {self.name} (NCBI Gene {self.record_id})"
+        return f"the condition {self.name} (MedGen {self.record_id})"
+
+    def label(self) -> str:
+        """What replaces the phrase in a choice offered as a button."""
+        if self.kind == "organism":
+            return self.name or f"the organism NCBI Taxonomy {self.record_id}"
+        if self.kind == "gene":
+            return f"the gene {self.name}"
+        return self.name
+
+
+@dataclass(frozen=True)
+class PhraseLookup:
+    """What NCBI answered for one whole phrase."""
+
+    phrase: str
+    fits: tuple[PhraseFit, ...]
+    #: False when Taxonomy or MedGen could not be asked (a transport failure
+    #: or the lookup's own cap), so "none" or "one" is not proven.
+    complete: bool
+
+    @property
+    def outcome(self) -> Outcome:
+        if len(self.fits) >= 2:
+            return "several"
+        if not self.complete:
+            return "unknown"
+        return "one" if self.fits else "none"
+
+
+def _symbol_shaped(phrase: str) -> bool:
+    return bool(_SYMBOL_SHAPE.fullmatch(phrase.strip()))
+
+
+async def _taxonomy_names(taxids: Sequence[str]) -> dict[str, str]:
+    """Taxonomy scientific names for `taxids`, one ESummary, or {} when NCBI
+    did not answer. Only ever a label: a missing name never changes what
+    binds."""
+    from system_03_search_agent.tools import ncbi_eutils_actions
+    from system_03_search_agent.tools.ncbi_efetch_schemas import NcbiEfetchSummaryInput
+
+    try:
+        found = await ncbi_eutils_actions.summary(
+            NcbiEfetchSummaryInput(action="summary", db="taxonomy", ids=list(taxids))
+        )
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("Taxonomy name lookup failed: %s", type(exc).__name__)
+        return {}
+    if getattr(found, "status", None) != "ok":
+        return {}
+    names: dict[str, str] = {}
+    for record in found.records:
+        taxid = str(record.fields.get("taxid") or getattr(record, "id", "") or "").strip()
+        name = record.fields.get("scientificname")
+        if taxid and isinstance(name, str) and name.strip():
+            names[taxid] = " ".join(name.split())[:_MAX_OPTION_CHARS]
+    return names
+
+
+async def look_up(
+    phrase: str, gene_taxon: str | None, budget: LookupBudget
+) -> PhraseLookup | None:
+    """The whole phrase in Taxonomy, Gene and MedGen, or None when the
+    question has used its `MAX_PHRASES`. Never raises; never cuts the phrase.
+    """
+    from system_03_search_agent.core import graph
+
+    if not budget.take_phrase():
+        return None
+    with budget.calls():
+        taxids = await graph._organism_taxids(phrase, graph._MAX_ORGANISM_LOOKUP_CHARS)
+        gene_curie: str | None = None
+        if gene_taxon and _symbol_shaped(phrase):
+            gene_curie = await graph.resolve_symbol_to_curie(phrase.strip(), taxon=gene_taxon)
+        medgen = await graph.medgen_exact_title_records(phrase)
+        names = await _taxonomy_names(taxids) if taxids else {}
+    fits: list[PhraseFit] = [
+        PhraseFit(kind="organism", record_id=taxid, name=names.get(taxid, ""))
+        for taxid in taxids or ()
+    ]
+    if gene_curie is not None:
+        fits.append(
+            PhraseFit(
+                kind="gene",
+                record_id=gene_curie.split(":", 1)[1],
+                name=phrase.strip().upper(),
+                organism=gene_taxon or "",
+            )
+        )
+    fits.extend(
+        PhraseFit(kind="condition", record_id=concept_id, name=title)
+        for concept_id, title in medgen or ()
+    )
+    return PhraseLookup(
+        phrase=phrase,
+        fits=tuple(fits),
+        complete=taxids is not None and medgen is not None,
+    )
+
+
+async def split_unplaced_runs(
+    candidates: Sequence[str], budget: LookupBudget
+) -> list[tuple[str, bool]]:
+    """Each candidate as `(text, split_out)`. A multi-word candidate is kept
+    whole when NCBI Taxonomy knows it as a name ("SARS CoV-2"), and when the
+    check could not run, so a name is never cut on a guess. When Taxonomy
+    answers that it knows no such name ("BRCA1 ClinVar"), its whole words
+    are returned with `split_out` True: the caller may try such a word only
+    as an exact gene symbol, never as a disease or in the whole-phrase
+    lookup, because a word split out of a name Taxonomy did not recognise
+    ("SARS" out of "SARS.CoV.2") may still be a piece of that name. One
+    cached Taxonomy search per run, charged to `budget`'s calls but not to
+    its phrases."""
+    from system_03_search_agent.core import graph
+
+    out: list[tuple[str, bool]] = []
+    for candidate in candidates:
+        words = name_words(candidate)
+        if len(words) < 2:
+            # A single word, hyphen-joined or not, is never split.
+            out.append((candidate, False))
+            continue
+        with budget.calls():
+            taxids = await graph._organism_taxids(candidate, graph._MAX_ORGANISM_LOOKUP_CHARS)
+        if taxids is None or taxids:
+            out.append((candidate, False))
+            continue
+        for word in words:
+            text = candidate[word.start : word.end]
+            if is_candidate_name(text):
+                out.append((text, True))
+    return out
+
+
+# ---------------------------------------------------------------------------
+# What the person reads
+# ---------------------------------------------------------------------------
+
+
+def _quoted(phrase: str) -> str:
+    printable = "".join(ch if ch.isprintable() else " " for ch in phrase)
+    text = " ".join(printable.replace("'", "").split())
+    if len(text) > _MAX_QUOTED_CHARS:
+        text = text[:_MAX_QUOTED_CHARS].rstrip() + "..."
+    return text or "this name"
+
+
+def reading_line(phrase: str, fit: PhraseFit) -> str:
+    """The plan line naming the record a phrase was read as."""
+    return f"Read '{_quoted(phrase)}' as {fit.describe()}"
+
+
+def several_question(lookup: PhraseLookup, question_text: str) -> tuple[str, list[str]]:
+    """The question asked back when a phrase fits several NCBI records, and
+    the choices offered as buttons: the person's own question with the
+    phrase replaced by each record's name, so a click asks it again without
+    the doubt, or the record's name alone when that would be too long."""
+    phrase = _quoted(lookup.phrase)
+    question = (
+        f"'{phrase}' matches more than one NCBI record, so I have not picked one "
+        "for you. Choose the one you mean below, or ask again using its full "
+        "name."
+    )
+    pattern = re.compile(re.escape(lookup.phrase.strip()), re.IGNORECASE)
+    options: list[str] = []
+    for fit in lookup.fits:
+        label = fit.label()
+        rewritten = pattern.sub(lambda _match, label=label: label, question_text.strip(), count=1)
+        option = rewritten if rewritten != question_text.strip() else label
+        if len(option) > _MAX_OPTION_CHARS:
+            option = label[:_MAX_OPTION_CHARS]
+        option = " ".join("".join(ch if ch.isprintable() else " " for ch in option).split())
+        if option and option not in options:
+            options.append(option)
+        if len(options) >= _MAX_OPTIONS:
+            break
+    return question, options
+
+
+def none_question(phrases: Sequence[str], records: str) -> str:
+    """The question asked back when a question asks for an organism's
+    records and no phrase the model named fits any NCBI record. It says
+    what was looked up and what to type next."""
+    quoted = " or ".join(f"'{_quoted(phrase)}'" for phrase in phrases[:MAX_PHRASES])
+    return (
+        f"I could not find {quoted} as an organism, gene or condition in NCBI, "
+        f"so I cannot tell which organism's {records} you want. Ask again "
+        "naming the organism as NCBI spells it, for example "
+        f"\"{records} of Escherichia coli\"."
+    )
