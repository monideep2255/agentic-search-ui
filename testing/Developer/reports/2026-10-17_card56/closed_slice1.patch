+#: asked for SRA runs or assemblies and named no organism and no disease,
+#: so nothing in it can say whose records are wanted.
+_ContentRetryReason = Literal["nothing", "records"]
+_SUBJECT_ENTITY_TYPES: Final[frozenset[str]] = frozenset({"gene", "disease", "organism"})
+
+
+def _content_retry_reason(classification: _ThinkClassification) -> _ContentRetryReason | None:
+    """Whether a parsed Think reply is asked for once more, and why. A
+    reply that names a gene, disease or organism pays nothing, unless it
+    asks for an organism's records and names only genes."""
+    named = {entity.entity_type for entity in classification.entities}
+    if not named & _SUBJECT_ENTITY_TYPES:
+        return "nothing"
+    if classification.record_type in breadth_plan.ORGANISM_RECORD_DBS and not (
+        named & {"organism", "disease"}
+    ):
+        return "records"
+    return None
+
