+            call_budget.charge_one_call(tool="question", layer=2)
+        with budget.calls():
+            for _ in range(7):
+                call_budget.charge_one_call(tool="lookup", layer=2)
+        with budget.calls():
+            for _ in range(3):
+                call_budget.charge_one_call(tool="lookup", layer=2)
+            with pytest.raises(call_budget.CallBudgetExceededError):
+                call_budget.charge_one_call(tool="lookup", layer=2)
+        assert call_budget.calls_made() == 5
+    assert budget.calls_used == phrase_lookup.MAX_CALLS == 10
+
+
+@pytest.mark.asyncio
+async def test_a_lookup_past_the_call_cap_is_unknown_and_binds_nothing(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _Ncbi(monkeypatch)
+    budget = phrase_lookup.LookupBudget("lookup")
+    budget.calls_used = phrase_lookup.MAX_CALLS
+    found = await phrase_lookup.look_up("SARS CoV-2", "human", budget)
+    assert found is not None and found.outcome == "unknown" and found.fits == ()
