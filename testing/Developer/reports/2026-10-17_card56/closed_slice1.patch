+def test_the_ask_wording_never_overflows_the_event_contract() -> None:
+    lookup = phrase_lookup.PhraseLookup(
+        phrase="x" * 200,
+        fits=tuple(
+            phrase_lookup.PhraseFit(kind="organism", record_id=str(i), name="y" * 300)
+            for i in range(6)
+        ),
+        complete=True,
+    )
+    question, options = phrase_lookup.several_question(lookup, "q " * 300)
+    assert len(question) <= 500 and len(options) <= 4
+    assert all(len(option) <= 220 for option in options)
+    assert len(phrase_lookup.none_question(["z" * 300, "w" * 300], "genome assemblies")) <= 500
