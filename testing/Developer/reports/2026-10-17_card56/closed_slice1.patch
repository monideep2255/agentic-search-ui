+def _content_retry_message(reason: _ContentRetryReason, record_type: str) -> str:
+    """The second request's own words: what was missing from the reply,
+    never a hint at which span to report. Fixed text plus the schema's key
+    list and the reply's own record type, nothing from the question."""
+    if reason == "records":
+        missing = (
+            f'That reply set "record_type" to "{record_type}" but named no '
+            "organism or disease whose records are wanted."
+        )
+    else:
+        missing = "That reply named no gene, disease or organism."
+    return (
+        f"{missing} Read the query again. If it names a gene, a disease or "
+        "condition, or an organism (a species, strain or virus, however it "
+        "is spelled, spaced or hyphenated), list each such span exactly as "
+        "written. Leave \"entities\" empty only if the query names none of "
+        "these. Reply again with a single JSON object using exactly these "
+        f"keys: {_THINK_RETRY_KEY_LIST}."
+    )
+
