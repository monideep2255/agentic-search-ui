+def merge_sentences_by_citation(
+    entries: list[tuple[str, SynthFinding | None]]
+) -> list[tuple[str, SynthFinding | None]]:
+    """Collapse a record's own several grounded sentences into one entry.
+
+    Card 26 (2026-09-25): "A record with several sentences shows as one
+    entry, not several list rows." Item 11.34 marks every sentence of a
+    multi-sentence finding value with that finding's own `ref_index`, so
+    `run_grounding_pass` grounds each sentence of a long abstract or gene
+    summary independently rather than losing the whole value to one
+    trailing, unreachable marker (`findings.build_structured_fallback_
+    narrative`'s docstring has the full mechanism, and `findings.
+    one_finding_per_record` is the sibling fix that keeps one row per
+    RECORD in the first place). The grounding pass then hands back one
+    surviving sentence per marked clause, still carrying that same
+    `ref_index`, so a caller walking those sentences one at a time to build
+    list rows (`core.graph`'s `listing` closure) puts each surviving
+    sentence of one three-sentence abstract on its own row, under one
+    shared record heading, instead of joining them into the one entry that
+    record actually is.
+
+    `entries` is `(sentence, finding_or_none)` pairs in the order a caller
+    already has them, the same shape `core.graph.listing` builds before
+    grouping by type. Two entries are the SAME record when their findings
+    share a `citation_id`, never by object identity: two markers of one
+    record are two distinct `SynthFinding` objects with identical field
+    values, both live cases in `findings.build_structured_fallback_
+    narrative`. Kept sentences join with a single space in survival order,
+    so a record's own sentences read together and in the order they
+    survived grounding, and the merged entry keeps the FIRST occurrence's
+    position, so a record's row still appears where its first sentence did.
+    An entry whose `finding` is None (an unmarked framing sentence
+    `run_grounding_pass` can still return) merges with nothing: it names no
+    record for a heading to attach to, and stays its own row exactly as
+    before.
+    """
+    merged: list[list[Any]] = []
+    index_by_citation: dict[str, int] = {}
+    for sentence, finding in entries:
+        if finding is None:
+            merged.append([sentence, None])
+            continue
+        key = finding.citation_id
+        existing = index_by_citation.get(key)
+        if existing is None:
+            index_by_citation[key] = len(merged)
+            merged.append([sentence, finding])
+            continue
+        merged[existing][0] = f"{merged[existing][0]} {sentence}"
+    return [(text, finding) for text, finding in merged]
+
+
