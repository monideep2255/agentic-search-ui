+def test_a_multi_sentence_record_becomes_one_list_entry() -> None:
+    """Card 26 (2026-09-25): item 11.34's per-sentence marking, replayed
+    here as the three-sentence abstract of one paper surviving grounding as
+    three separate sentences that all carry the SAME finding (the real
+    mechanism: `findings.build_structured_fallback_narrative` marks every
+    sentence of one multi-sentence value with that finding's own
+    ref_index). Before the fix, three rows shared one heading; after, one
+    row carries all three sentences in order.
+    """
+    paper = _finding(
+        1, "Sentence one.", field="abstract", entity_type="Publication", tool="ncbi_efetch"
+    )
+    entries = [
+        ("Sentence one.", paper),
+        ("Sentence two.", paper),
+        ("Sentence three.", paper),
+    ]
+    merged = merge_sentences_by_citation(entries)
+    assert merged == [("Sentence one. Sentence two. Sentence three.", paper)]
+
+
+def test_two_different_records_stay_two_entries() -> None:
+    """The merge must never fold two DIFFERENT records into one row just
+    because they were grounded next to each other."""
+    first = _finding(1, "First record sentence.", entity_type="Publication", tool="ncbi_efetch")
+    second = _finding(2, "Second record sentence.", entity_type="Publication", tool="ncbi_efetch")
+    entries = [("First record sentence.", first), ("Second record sentence.", second)]
+    assert merge_sentences_by_citation(entries) == entries
+
+
+def test_an_unmarked_framing_sentence_is_never_merged() -> None:
+    """A sentence with no finding at all (bare framing, `run_grounding_pass`
+    can still return one) names no record, so it must stay its own row and
+    must never absorb, or be absorbed into, a neighbouring record's row."""
+    paper = _finding(1, "The record sentence.", entity_type="Publication", tool="ncbi_efetch")
+    entries: list[tuple[str, SynthFinding | None]] = [
+        ("Framing text.", None),
+        ("The record sentence.", paper),
+    ]
+    assert merge_sentences_by_citation(entries) == entries
+
+
+def test_a_record_that_reappears_later_still_merges_into_its_first_row() -> None:
+    """The merged row keeps the FIRST occurrence's position, so a record's
+    row still appears where its first sentence did even when its later
+    sentence arrives after another record's row."""
+    first = _finding(1, "First record sentence.", entity_type="Publication", tool="ncbi_efetch")
+    second = _finding(2, "Second record sentence.", entity_type="Publication", tool="ncbi_efetch")
+    entries = [
+        ("First record sentence.", first),
+        ("Second record sentence.", second),
+        ("First record's later sentence.", first),
+    ]
+    assert merge_sentences_by_citation(entries) == [
+        ("First record sentence. First record's later sentence.", first),
+        ("Second record sentence.", second),
+    ]
