+# ------------------------------------ Card 25 (2026-09-25): a generic shared
+# word must not be enough to name a record switch.
+
+TAY_SACHS = SynthFinding(
+    ref_index=30,
+    citation_id="c-30",
+    layer="layer_2_ncbi_api",
+    tool="ncbi_efetch",
+    field="abstract",
+    field_value="Tay-Sachs disease results from mutations in the HEXA gene.",
+    source_url="https://pubmed.ncbi.nlm.nih.gov/30/",
+    entity_type="Publication",
+    curie="pubmed:30",
+)
+# The word "patients" appears in BOTH titles below, on purpose: that is what
+# makes it generic clinical vocabulary rather than either record's own name,
+# and it is what the residual defect (testing/UI_fixes_done.md, item 12.16
+# part 4) actually rested on. A live BRCA paper's title happened to carry
+# "patients"; nothing about that word was BRCA's alone. Neither title
+# carries "mutation" or "mutations": that word is left for the probe
+# sentences below to use as the genuinely DISTINGUISHING word, so the two
+# tests only ever differ in whether the probe also says something the BRCA
+# title alone carries ("breast" or "cancer").
+TAY_SACHS_TITLE = replace_finding(
+    TAY_SACHS,
+    ref_index=31,
+    citation_id="c-31",
+    field="title",
+    field_value="Tay-Sachs disease diagnosis in patients",
+)
+BRCA = SynthFinding(
+    ref_index=32,
+    citation_id="c-32",
+    layer="layer_2_ncbi_api",
+    tool="ncbi_efetch",
+    field="abstract",
+    field_value="No patient carried more than one of these mutations in the cohort.",
+    source_url="https://pubmed.ncbi.nlm.nih.gov/32/",
+    entity_type="Publication",
+    curie="pubmed:32",
+)
+BRCA_TITLE = replace_finding(
+    BRCA,
+    ref_index=33,
+    citation_id="c-33",
+    field="title",
+    field_value="Breast cancer risk assessment in patients",
+)
+TAY_SACHS_FIRST = "Tay-Sachs disease results from mutations in the HEXA gene [30]. "
+
+
+def _approve_tay_sachs_and_brca(narrative: str) -> object:
+    sink: list[SynthesisCandidate] = []
+    findings = [TAY_SACHS, TAY_SACHS_TITLE, BRCA, BRCA_TITLE]
+    run_grounding_pass(narrative, findings, question=QUESTION, candidate_sink=sink)
+    return run_grounding_pass(
+        narrative, findings, question=QUESTION,
+        verified_syntheses=frozenset(c.key for c in sink),
+    )
+
+
+def test_a_generic_shared_word_does_not_name_the_switch() -> None:
+    """Measured live (testing/UI_fixes_done.md, item 12.16 part 4, residual):
+    after a Tay-Sachs sentence, "No patient carried more than one of these
+    mutations" cited a BRCA paper whose title says "patients", and the
+    shared word "patient" was accepted as naming the switch. It names
+    nothing: "patients" sits in the Tay-Sachs title too, so it cannot say
+    which of the two records the sentence switched to. The sentence must be
+    dropped, and Tay-Sachs must be the only sentence left standing.
+    """
+    wrong = TAY_SACHS_FIRST + (
+        "No patient had more than one of these mutations "
+        '[32: "No patient carried more than one of these mutations in the cohort"].'
+    )
+    result = _approve_tay_sachs_and_brca(wrong)
+    assert len(result.sentences) == 1, result.sentences
+    assert "Tay-Sachs" in result.sentences[0]
+
+
+def test_a_distinguishing_word_still_names_the_switch() -> None:
+    """The fix must not become a blanket ban on switching records: a word
+    that names ONLY the record being switched to still licenses it, exactly
+    as `test_naming_the_other_record_instead_of_referring_back_stays` proves
+    for G6PD/MEFV above."""
+    named = TAY_SACHS_FIRST + (
+        "No breast cancer patient had more than one of these mutations "
+        '[32: "No patient carried more than one of these mutations in the cohort"].'
+    )
+    result = _approve_tay_sachs_and_brca(named)
+    assert len(result.sentences) == 2, result.sentences
+
+
