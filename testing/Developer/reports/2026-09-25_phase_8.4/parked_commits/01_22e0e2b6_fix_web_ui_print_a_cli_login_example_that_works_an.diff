+/*
+ * Card 30, measured 2026-09-25
+ * (`testing/Developer/reports/2026-09-25_phase_8.5/`): `s3 login` printed
+ * with no argument fails as run, because `main.py`'s `_parse_login_args`
+ * declares `email` a required positional (`parser.add_argument("email", ...)`,
+ * no default). The command below adds that argument, with a placeholder
+ * address rather than a real one, the same convention every other login
+ * example on the web uses. It also sets `S3_BASE_URL` first: `_run_login`
+ * falls back to `_DEFAULT_BASE_URL`, `http://127.0.0.1:8000`, a local-dev
+ * address, when neither `--base-url` nor this variable is set, so a reader
+ * who only pasted the two original lines would have logged in against their
+ * own laptop rather than this deployment. `s3 ask` needs no base URL of its
+ * own: it reads the one `s3 login` already stored in the credential file.
+ * The password itself is never printed or scripted; `s3 login` reads it from
+ * stdin, unechoed on a real terminal, exactly as it does today.
+ */
+export const CLI_EXAMPLE = `export S3_BASE_URL=${API_ORIGIN}
+s3 login you@example.org
 s3 ask "diseases linked to BRCA1"`;
 
