+/**
+ * What one records block's rows plainly ARE, for the pager's own count
+ * (card 31, 2026-09-25). A live TP53 answer once showed "78 sources from 3
+ * layers" in the status strip, "of 124 available" in its lead sentence and
+ * "Showing 1 to 10 of 59" in this pager, three true numbers with nothing to
+ * say which counted what
+ * (`testing/Developer/reports/2026-09-20_tp53_findings/findings.md`, D-2).
+ * This is the pager's half of the fix: name the noun rather than leaving the
+ * number bare.
+ *
+ * Only a `record_line` block carries a usable label at all ("Disease name",
+ * "Sequence variant name", from `parseRecordLine`), and even that is not the
+ * plain noun a reader wants ("59 disease name rows"), so the trailing field
+ * word is stripped before lowercasing. A `table_row` or `list_item` block
+ * carries no entity name anywhere in `AnswerBlock` (only column headers,
+ * which do not reliably name what a ROW is), so it falls back to `null`
+ * rather than guessing from a header cell.
+ */
+export function recordRowNoun(block: Extract<AnswerBlock, { type: "records" }>): string | null {
+  if (!block.label) return null;
+  const stripped = block.label
+    .replace(new RegExp(`\\s+(?:${RECORD_LINE_FIELDS.join("|")})$`, "i"), "")
+    .trim();
+  return stripped.length > 0 ? stripped.toLowerCase() : null;
+}
+
+/** The pager's own count phrase: names the noun when one is derivable,
+ *  falls back to the generic "records" rather than repeating a word twice
+ *  ("record rows"). */
+export function recordsCountLabel(
+  block: Extract<AnswerBlock, { type: "records" }>,
+  totalRows: number,
+): string {
+  const noun = recordRowNoun(block);
+  return noun ? `${totalRows} ${noun} rows` : `${totalRows} records`;
+}
+
 export interface Source {
