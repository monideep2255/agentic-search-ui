@@ -0,0 +1,90 @@
+/**
+ * Card 31 (2026-09-25): the status strip's own count names what it counts.
+ * A live TP53 answer once showed "78 sources from 3 layers" here, "of 124
+ * available" in its lead sentence and "Showing 1 to 10 of 59" in a table
+ * pager, three true numbers about three different things
+ * (`testing/Developer/reports/2026-09-20_tp53_findings/findings.md`, D-2).
+ * This pins the strip's own half: "sources" became "sources cited",
+ * naming exactly what distinguishes it from the other two ("cited" versus
+ * "found" versus "shown on this page"). The number itself is untouched.
+ */
+
+import { renderHook } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+
+import type { AgentEvent } from "../lib/events";
+import { useRunView } from "./useRunView";
+
+let seq = 0;
+function envelope<TType extends AgentEvent["type"]>(
+  type: TType,
+  payload: Extract<AgentEvent, { type: TType }>["payload"],
+): AgentEvent {
+  seq += 1;
+  return { type, version: "v1", trace_id: "t", seq, ts: "2026-09-25T00:00:00Z", payload } as AgentEvent;
+}
+
+const GUARD = envelope("guard", { passed: true, category: "ok", reason: null });
+const THINK = envelope("think", {
+  narrative: "Resolving BRCA1.",
+  query_class: "single_hop",
+  resolved_entities: [],
+  clarifying_question: null,
+});
+const PLAN = envelope("plan", {
+  narrative: "Read the curated edges.",
+  tool_calls: [{ tool: "cypher_query", call_id: "c1", layer: "layer_1_graph", persona: "Levi-Montalcini" }],
+});
+const TOOL_RESULT = envelope("tool_result", {
+  call_id: "c1",
+  tool: "cypher_query",
+  layer: "layer_1_graph",
+  status: "ok",
+  persona: "Levi-Montalcini",
+  summary: "",
+  result_count: 3,
+  truncated: false,
+});
+const citation = (id: string, index: number) =>
+  envelope("citation", {
+    citation_id: id,
+    display_index: index,
+    source: "NCBI Gene",
+    source_id: "672",
+    source_url: "https://www.ncbi.nlm.nih.gov/672",
+    layer: "layer_1_graph",
+    field: "cypher_query",
+    claim_text: "x",
+    evidence_kind: "curated assertion",
+    assertion_confidence: "high",
+    population_ancestry_context: null,
+    license: "public domain",
+  });
+const TOKEN = envelope("token", { text: "BRCA1 causes HBOC [1][2]. ", marker_ids: ["k1", "k2"] });
+const DONE = envelope("done", { total_cost_usd: 0.001, total_tool_calls: 1, elapsed_ms: 900, trust_outcome: "answer" });
+
+describe("the status strip's meta line names what its sources figure counts", () => {
+  it("says 'sources cited', not a bare 'sources'", () => {
+    const view = renderHook(() =>
+      useRunView([GUARD, THINK, PLAN, TOOL_RESULT, citation("k1", 1), citation("k2", 2), TOKEN, DONE]),
+    ).result.current;
+
+    expect(view.meta).toBe("1 tool · 2 sources cited from 1 layer");
+  });
+
+  it("keeps singular wording for exactly one source, still naming it as cited", () => {
+    const view = renderHook(() =>
+      useRunView([
+        GUARD,
+        THINK,
+        PLAN,
+        TOOL_RESULT,
+        citation("k1", 1),
+        envelope("token", { text: "BRCA1 causes HBOC [1]. ", marker_ids: ["k1"] }),
+        DONE,
+      ]),
+    ).result.current;
+
+    expect(view.meta).toBe("1 tool · 1 source cited from 1 layer");
+  });
+});
