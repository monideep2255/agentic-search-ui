+/**
+ * Card 31 (2026-09-25), the screen half: "every count names what it
+ * counts." This pins the Sources disclosure's own badge: a bare number
+ * visually (unchanged, the design system's own badge shape), with an
+ * accessible name that says in plain words what it is a count OF, and how
+ * it differs from the status strip's "N sources cited" (a citation-marker
+ * count) when the two legitimately disagree because one record answers for
+ * more than one marker.
+ */
+
+import { render, screen, within } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+
+import { AnswerScreen } from "./AnswerScreen";
+import type { Claim, Source } from "./AnswerScreen";
+
+const GENE_672: Source = {
+  n: 1,
+  layer: 1,
+  name: "NCBI Gene 672 · BRCA1",
+  tool: "cypher_query",
+  evidence: "curated assertion",
+  confidence: "high",
+  license: "public domain",
+  url: "https://www.ncbi.nlm.nih.gov/gene/672",
+};
+
+/** A second citation marker pointing at the SAME record as `GENE_672`. */
+const GENE_672_AGAIN: Source = { ...GENE_672, n: 2 };
+
+const CLAIMS: Claim[] = [
+  { text: "Gene 672 causes disease A.", layer: 1, citations: [1] },
+  { text: "Gene 672 also causes disease B.", layer: 1, citations: [2] },
+];
+
+describe("the Sources disclosure's own count names what it counts", () => {
+  it("says how many distinct records, in plain words, in its accessible name", () => {
+    render(
+      <AnswerScreen
+        question="Which diseases are associated with BRCA1?"
+        claims={CLAIMS}
+        sources={[GENE_672, GENE_672_AGAIN]}
+      />,
+    );
+
+    const disclosure = screen.getByTestId("sources-disclosure");
+    const badge = within(disclosure).getByTestId("sources-count");
+    // The visible glyph is still the bare number, unchanged.
+    expect(badge).toHaveTextContent("1");
+    // Its accessible name says what that "1" is a count of: one distinct
+    // record, even though TWO citation markers ([1] and [2]) point at it.
+    expect(badge).toHaveAccessibleName(/1 distinct source record listed below/i);
+  });
+});
