+/**
+ * Card 31 (2026-09-25), the screen half: "every count names what it
+ * counts." Fixed against the live TP53 answer that showed "78 sources from
+ * 3 layers" in the status strip, "of 124 available" in its lead sentence
+ * and "Showing 1 to 10 of 59" in a table pager, three true numbers with
+ * nothing to distinguish them
+ * (`testing/Developer/reports/2026-09-20_tp53_findings/findings.md`, D-2).
+ * The backend's two strings ("of 124 available", "not shown above") are
+ * unchanged here per the ticket; only what the frontend renders is fixed.
+ */
+
+import { describe, expect, it } from "vitest";
+
+import type { AnswerBlock, Claim } from "./components/screens/AnswerScreen";
+import { recordRowNoun, recordsCountLabel } from "./components/screens/AnswerScreen";
+
+const recordLineClaim = (label: string, index: number): Claim => ({
+  text: `${label}: value ${index}`,
+  layer: 1,
+  citations: [index],
+});
+
+function recordLineBlock(label: string, rows: number): Extract<AnswerBlock, { type: "records" }> {
+  const claim = recordLineClaim(label, 0);
+  return {
+    type: "records",
+    key: "records-0",
+    source: "record_line",
+    label,
+    header: null,
+    rows: Array.from({ length: rows }, (_, i) => ({ claim, index: i, cells: [`value ${i}`] })),
+  };
+}
+
+function tableBlock(rows: number): Extract<AnswerBlock, { type: "records" }> {
+  const claim: Claim = { text: "row", layer: 1, citations: [], kind: "table_row", cells: ["a"] };
+  return {
+    type: "records",
+    key: "records-1",
+    source: "table_row",
+    label: null,
+    header: ["Name", "Identifier"],
+    rows: Array.from({ length: rows }, (_, i) => ({ claim, index: i, cells: ["a", "b"] })),
+  };
+}
+
+describe("recordRowNoun", () => {
+  it("strips the field word off a record_line block's own label", () => {
+    expect(recordRowNoun(recordLineBlock("Disease name", 3))).toBe("disease");
+    expect(recordRowNoun(recordLineBlock("Sequence variant name", 3))).toBe("sequence variant");
+    expect(recordRowNoun(recordLineBlock("Gene symbol", 3))).toBe("gene");
+    expect(recordRowNoun(recordLineBlock("Clinical trial title", 3))).toBe("clinical trial");
+  });
+
+  it("returns null for a table_row or list_item block, which carries no entity name", () => {
+    expect(recordRowNoun(tableBlock(59))).toBeNull();
+  });
+});
+
+describe("recordsCountLabel", () => {
+  it("names the noun when one is derivable from the block's own label", () => {
+    expect(recordsCountLabel(recordLineBlock("Sequence variant name", 59), 59)).toBe("59 sequence variant rows");
+  });
+
+  it("falls back to the generic noun rather than repeating a word twice", () => {
+    // "record rows" would read as an accident; a plain "records" reads as
+    // the honest fallback when the block carries no entity name at all.
+    expect(recordsCountLabel(tableBlock(59), 59)).toBe("59 records");
+  });
+
+  it("never changes the number itself, only what surrounds it", () => {
+    expect(recordsCountLabel(recordLineBlock("Disease name", 124), 124)).toContain("124");
+  });
+});
