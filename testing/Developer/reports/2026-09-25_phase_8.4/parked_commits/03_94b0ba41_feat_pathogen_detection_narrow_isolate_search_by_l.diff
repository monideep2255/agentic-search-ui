+
+def _year_in_range(text: str) -> int | None:
+    """One 4-digit year, or None when it falls outside the plausible
+    calendar range this module and the tool schema share. Never raises on
+    an out-of-range year; the caller drops it instead, the same
+    fail-closed discipline `pathogen_detection.py`'s own
+    `_parse_collection_year` uses for a malformed cell.
+    """
+    year = int(text)
+    if _MIN_YEAR <= year <= _MAX_YEAR:
+        return year
+    return None
+
+
+def _find_collection_years(text: str) -> tuple[int | None, int | None]:
+    """The `(collection_year_min, collection_year_max)` a fixed date-phrase
+    rule reads from the question's own words, or `(None, None)` when none
+    of the five phrases below appears. See this module's own "Card 28"
+    docstring section for why this is a closed set of function-word
+    patterns, not an open-ended vocabulary, and therefore not the kind of
+    hardcoded word list DECISIONS.md 2026-09-24 forbids.
+    """
+    between = _YEAR_BETWEEN.search(text)
+    if between is not None:
+        low = _year_in_range(between.group(1))
+        high = _year_in_range(between.group(2))
+        if low is not None and high is not None and low > high:
+            low, high = high, low
+        return low, high
+
+    year_min: int | None = None
+    year_max: int | None = None
+
+    since = _YEAR_SINCE.search(text)
+    if since is not None:
+        year_min = _year_in_range(since.group(1))
+
+    before = _YEAR_BEFORE.search(text)
+    if before is not None:
+        year = _year_in_range(before.group(1))
+        if year is not None and year > _MIN_YEAR:
+            year_max = year - 1
+
+    through = _YEAR_THROUGH.search(text)
+    if through is not None:
+        year_max = _year_in_range(through.group(1))
+
+    if year_min is None and year_max is None:
+        bare = _YEAR_IN.search(text)
+        if bare is not None:
+            year = _year_in_range(bare.group(1))
+            year_min = year
+            year_max = year
+
+    return year_min, year_max
+
 
