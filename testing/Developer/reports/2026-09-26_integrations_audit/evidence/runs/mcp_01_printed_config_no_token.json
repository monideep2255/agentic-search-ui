            "title": "Audience Depth",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Session Id"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "ask_biomedical_questionArguments"
      },
      "has_output_schema": true
    }
  ],
  "prompts_resources": {
    "prompts": 0,
    "resources": 0
  },
  "calls": [
    {
      "tool": "ask_biomedical_question",
      "args": {
        "query": "Which diseases are associated with BRCA1?"
      },
      "exception": "MCPError: missing, malformed, or invalid bearer token",
      "wall_s": 0.2
